# ====================================================================
# Recursive Field — .env.template
# Copy to .env and set your instance-specific values.
# ====================================================================

# --- Library Identity (cascades across all container names) ---
LIBRARY=recursive-field

# --- Knowledge Backing (swappable domain intelligence) ---
KNOWLEDGE_DIR=state/knowledge/tbc_corpus

# --- Field Root (auto-discovered by find_root.py; override here) ---
FIELD_ROOT=/a0/usr/projects/recursive-field

# --- Port Allocation Base (per-agent: PORT_BASE + idx * 100) ---
PORT_BASE=44000

# --- Container Image ---
IMAGE_NAME=agent0ai/agent-zero:latest
