# ====================================================================
# Recursive Field — operator-owned resolver input
# Copy to .env and set instance values. generate_compose.py never edits .env.
# Precedence: explicit CLI/function value, nonempty process environment,
# nonempty root .env value, then the documented generator default.
# ====================================================================

# Lowercase alphanumeric words separated by single hyphens.
LIBRARY=recursive-field

# Knowledge backing (consumed by environment/profile tooling).
KNOWLEDGE_DIR=state/knowledge/recursive_field

# Must canonically equal the .recursive-field-root marker-discovered directory.
# The validated absolute value is bound into generated Compose host mounts; it
# is not left as late ${FIELD_ROOT} interpolation.
FIELD_ROOT=/a0/usr/projects/recursive-field

# Agent slot i: PORT_BASE + i*100; SSH is slot+22.
# Active HTTP/API gateway slot j follows all agents; HTTP is slot+80.
PORT_BASE=44000

# Agent runtime image.
IMAGE_NAME=agent0ai/agent-zero:latest
