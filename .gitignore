# ====================================================================
# Recursive Field — .gitignore
# Enforces Git vs. Generated Separation:
#   Committed = The Scaffold (scripts, spec, seeds, knowledge templates)
#   Ignored   = The Runtime State (deployed agents, meshes, gateways, .env)
# ====================================================================

# --- Resolver Switchboard (contains instance-specific identity) ---
.env

# --- Runtime Directories (created by init_environment.py) ---
agents/
mesh/
gateways/

# --- Scratch & Temporary State ---
tmp/

# --- State Snapshots & Ledgers (generated by persist_state.py) ---
state/snapshots/
state/ledger.jsonl

# --- Runtime Governance State (generated by system_control.py) ---
state/control_profile.json
state/hierarchy.json

# --- Formation-Owned Continuation Runtime (intent/checkpoint instances) ---
state/continuations/

# --- Keys & Secrets ---
keys/
*.key
*.pem

# --- Generated Docker Compose (regenerated by generate_compose.py) ---
docker-compose.yml

# --- Agent Zero Project (framework, not part of scaffold) ---
.a0proj/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/

# --- OS & Editor ---
.DS_Store
Thumbs.db
.vscode/
.windsurf/
.idea/
*.swp
*.swo
*~
