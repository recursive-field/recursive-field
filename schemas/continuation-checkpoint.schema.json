{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-field.local/schemas/continuation-checkpoint.schema.json",
  "title": "Recursive Field continuation checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "checkpoint_id",
    "intent_id",
    "field_genesis_uuid",
    "context_id",
    "recorded_at",
    "sequence",
    "state",
    "interruption_class",
    "token_snapshot",
    "retry_budget",
    "work_snapshot",
    "security",
    "context_evidence",
    "effect_boundary",
    "lease",
    "dispatch",
    "previous_checkpoint",
    "checkpoint_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuation_checkpoint"
    },
    "checkpoint_id": {
      "type": "string",
      "format": "uuid"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "field_genesis_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "armed",
        "active",
        "awaiting_human",
        "completed",
        "cancelled",
        "blocked",
        "failed"
      ]
    },
    "interruption_class": {
      "enum": [
        "self_initiated",
        "external"
      ]
    },
    "token_snapshot": {
      "$ref": "#/$defs/token_snapshot"
    },
    "retry_budget": {
      "$ref": "#/$defs/retry_budget"
    },
    "work_snapshot": {
      "$ref": "#/$defs/work_snapshot"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "context_evidence": {
      "$ref": "#/$defs/context_evidence"
    },
    "effect_boundary": {
      "$ref": "#/$defs/effect_boundary"
    },
    "lease": {
      "$ref": "#/$defs/lease"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    },
    "previous_checkpoint": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "checkpoint_sha256",
        "sequence"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "required_capabilities"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "context_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "context_id",
        "observed_at",
        "exists",
        "history_sha256",
        "evidence_sha256"
      ],
      "properties": {
        "source": {
          "const": "formation_attestation"
        },
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "exists": {
          "type": "boolean"
        },
        "history_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allows_actuation",
        "allowed_effects",
        "prohibited_effects"
      ],
      "properties": {
        "mode": {
          "const": "classification_only"
        },
        "allows_actuation": {
          "type": "boolean",
          "const": false
        },
        "allowed_effects": {
          "type": "array",
          "maxItems": 0
        },
        "prohibited_effects": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "agent_zero_api_call",
              "chat_mutation",
              "deployment",
              "external_effect_replay",
              "intent_claim",
              "lease_advance",
              "model_turn",
              "system_service_change"
            ]
          }
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "holder",
        "attempt_id",
        "generation",
        "boot_id",
        "acquired_at",
        "expires_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "unclaimed",
            "held",
            "released"
          ]
        },
        "holder": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "boot_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "dispatch_id",
        "effect_sha256",
        "observed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "unreconciled",
            "reconciled"
          ]
        },
        "dispatch_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "effect_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "token_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_source",
        "token_model"
      ],
      "properties": {
        "token_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "token_model": {
          "enum": [
            "capped",
            "metered"
          ]
        }
      }
    },
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_attempts",
        "attempts_used"
      ],
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "file_state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "status": {
          "enum": [
            "unchanged",
            "modified",
            "added",
            "deleted",
            "untracked"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "parallel_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "context_id",
        "state",
        "result_ref"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "success",
            "error",
            "cancelled",
            "timeout"
          ]
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "work_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_vector",
        "file_state",
        "git_commit",
        "subordinate_context_ids",
        "parallel_references"
      ],
      "properties": {
        "work_vector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "file_state": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/file_state_entry"
          }
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subordinate_context_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "parallel_references": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parallel_reference"
          }
        }
      }
    }
  }
}
