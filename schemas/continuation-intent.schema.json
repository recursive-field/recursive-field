{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-field.local/schemas/continuation-intent.schema.json",
  "title": "Recursive Field continuation intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "intent_id",
    "field_genesis_uuid",
    "context_id",
    "created_at",
    "status",
    "security",
    "context_evidence",
    "effect_boundary",
    "latest_checkpoint",
    "intent_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "continuation_intent"},
    "intent_id": {"type": "string", "format": "uuid"},
    "field_genesis_uuid": {"type": "string", "format": "uuid"},
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": [
        "armed",
        "active",
        "awaiting_human",
        "completed",
        "cancelled",
        "blocked",
        "failed"
      ]
    },
    "security": {"$ref": "#/$defs/security"},
    "context_evidence": {"$ref": "#/$defs/context_evidence"},
    "effect_boundary": {"$ref": "#/$defs/effect_boundary"},
    "latest_checkpoint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["checkpoint_id", "checkpoint_sha256"],
      "properties": {
        "checkpoint_id": {"type": "string", "format": "uuid"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intent_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "required_capabilities"],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "context_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "context_id",
        "observed_at",
        "exists",
        "history_sha256",
        "evidence_sha256"
      ],
      "properties": {
        "source": {"const": "formation_attestation"},
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "exists": {"type": "boolean"},
        "history_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allows_actuation",
        "allowed_effects",
        "prohibited_effects"
      ],
      "properties": {
        "mode": {"const": "classification_only"},
        "allows_actuation": {"type": "boolean", "const": false},
        "allowed_effects": {"type": "array", "maxItems": 0},
        "prohibited_effects": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "agent_zero_api_call",
              "chat_mutation",
              "deployment",
              "external_effect_replay",
              "intent_claim",
              "lease_advance",
              "model_turn",
              "system_service_change"
            ]
          }
        }
      }
    }
  }
}
