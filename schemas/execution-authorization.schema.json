{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "authorization_id",
    "adapter",
    "payload",
    "payload_sha256",
    "target",
    "acting_identity",
    "security_posture",
    "field_identity",
    "lineage",
    "effect_class",
    "expected_evidence",
    "evidence_attestation_sha256",
    "validity",
    "issuer",
    "operational_digest_sha256",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "execution_authorization"
    },
    "authorization_id": {
      "type": "string",
      "format": "uuid"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "registry_version",
        "registry_entry_sha256",
        "deterministic"
      ],
      "properties": {
        "adapter_id": {
          "const": "inspect_unit_cell"
        },
        "adapter_version": {
          "const": "1.0.0"
        },
        "registry_version": {
          "const": "1.0.0"
        },
        "registry_entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deterministic": {
          "const": true
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "namespace"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "acting_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "namespace"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "security_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "config_path",
        "config_sha256"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "field_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_genesis_uuid"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "field_genesis_uuid": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "phase_generation",
        "context_id",
        "intent_id",
        "intent_generation",
        "checkpoint_id",
        "checkpoint_sha256",
        "checkpoint_sequence",
        "lease"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "format": "uuid"
        },
        "phase_generation": {
          "type": "integer",
          "minimum": 0
        },
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "intent_id": {
          "type": "string",
          "format": "uuid"
        },
        "intent_generation": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "holder",
            "attempt_id",
            "generation",
            "boot_id",
            "acquired_at",
            "expires_at"
          ],
          "properties": {
            "holder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            },
            "attempt_id": {
              "type": "string",
              "format": "uuid"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "boot_id": {
              "type": "string",
              "format": "uuid"
            },
            "acquired_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "effect_class": {
      "const": "observation"
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_type",
              "path",
              "expected_exists"
            ],
            "properties": {
              "evidence_type": {
                "const": "file_exists"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "expected_exists": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_type",
              "path",
              "expected_sha256"
            ],
            "properties": {
              "evidence_type": {
                "const": "sha256_match"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_type",
              "ledger_path",
              "entry_id",
              "entry_sha256"
            ],
            "properties": {
              "evidence_type": {
                "const": "ledger_entry_present"
              },
              "ledger_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "entry_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]+$"
              },
              "entry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "evidence_attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued_at",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id",
        "authority",
        "policy_id",
        "policy_version",
        "policy_sha256",
        "model_orientation_authority"
      ],
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority": {
          "const": "deterministic_policy"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_orientation_authority": {
          "const": false
        }
      }
    },
    "operational_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-field.local/schemas/execution-authorization.schema.json",
  "title": "Recursive Field immutable deterministic execution authorization"
}
